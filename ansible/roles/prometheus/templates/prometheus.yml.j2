# {{ ansible_managed }}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for host in groups[prometheus_targets_group] | sort %}
      - targets: ['{{ hostvars[host].private_ip }}:{{ prometheus_node_exporter_port }}']
        labels:
          instance: '{{ host }}'
{% endfor %}
